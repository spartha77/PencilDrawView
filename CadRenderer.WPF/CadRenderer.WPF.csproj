<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CadRenderer.WPF - the application (C#, WPF).

    It has NO OpenGL code and NO OpenGL packages. Everything 3D goes through
    the CadBridge.CLI project reference below.

    Build this solution with Visual Studio (or msbuild.exe), not "dotnet build":
    the two C++ projects need the Visual C++ toolchain.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>CadRenderer.WPF</RootNamespace>
    <AssemblyName>CadRenderer</AssemblyName>

    <!-- The native engine is 64-bit, so the application must be too. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- The C++/CLI bridge. Visual Studio builds it (and CadCore.GL) first and
         copies CadBridge.CLI.dll + Ijwhost.dll next to the .exe. -->
    <ProjectReference Include="..\CadBridge.CLI\CadBridge.CLI.vcxproj" />
  </ItemGroup>

</Project>
