<?xml version="1.0" encoding="utf-8"?>
<!--
  CadCore.GL - native OpenGL engine, built as a STATIC LIBRARY.
  It is linked into CadBridge.CLI.dll, so nothing extra has to be deployed.

  Toolset: v145 = Visual Studio 2026. For Visual Studio 2022 change both
  <PlatformToolset> entries to v143.

  GLEW comes from the folder glew-2.3.1 next to CadGL.sln, through the user
  macros $(GLEW_INCLUDES) and $(GLEW_LIB_INCLUDES) defined below. The GLEW
  library is merged into CadCore.GL.lib by the Librarian settings.
  /MD(d) runtime is required because the library is linked into a /clr DLL.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6F1B0C2E-4D3A-4B8E-9C1F-2A7D5E8B9C01}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>CadCoreGL</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <!-- GLEW is taken from the glew-2.3.1 folder (see the user macros below), not from vcpkg. -->
    <VcpkgEnabled>false</VcpkgEnabled>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <!--
    GLEW location. GLEW is expected in a folder "glew-2.3.1" next to CadGL.sln:
        glew-2.3.1\include\GL\glew.h
        glew-2.3.1\lib\Debug\x64\glew32sd.lib  (and glew32d.lib)
        glew-2.3.1\lib\Release\x64\glew32s.lib (and glew32.lib)
    Another GLEW version or place: change the two macros here (or in
    Property Manager > User Macros). The same two macros are in both C++ projects.
  -->
  <PropertyGroup Label="UserMacros">
    <GLEW_INCLUDES>$(SolutionDir)glew-2.3.1\include</GLEW_INCLUDES>
    <GLEW_LIB_INCLUDES>$(SolutionDir)glew-2.3.1\lib\$(Configuration)\$(Platform)</GLEW_LIB_INCLUDES>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)platform;$(GLEW_INCLUDES);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- GLEW_STATIC: GLEW is linked statically (no glew32.dll to deploy). -->
      <PreprocessorDefinitions>GLEW_STATIC;NOMINMAX;WIN32_LEAN_AND_MEAN;_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Lib>
      <AdditionalLibraryDirectories>$(GLEW_LIB_INCLUDES);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Lib>
      <!-- The STATIC library first: with GLEW_STATIC defined it is the one used. -->
      <AdditionalDependencies>glew32sd.lib;glew32d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Lib>
      <!-- The STATIC library first: with GLEW_STATIC defined it is the one used. -->
      <AdditionalDependencies>glew32s.lib;glew32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="include\CadCore\Camera.h" />
    <ClInclude Include="include\CadCore\GLContext.h" />
    <ClInclude Include="include\CadCore\GpuObjects.h" />
    <ClInclude Include="include\CadCore\Light.h" />
    <ClInclude Include="include\CadCore\Material.h" />
    <ClInclude Include="include\CadCore\Math.h" />
    <ClInclude Include="include\CadCore\MeshNode.h" />
    <ClInclude Include="include\CadCore\PointCloudNode.h" />
    <ClInclude Include="include\CadCore\CurveNode.h" />
    <ClInclude Include="include\CadCore\Renderer.h" />
    <ClInclude Include="include\CadCore\Scene.h" />
    <ClInclude Include="include\CadCore\SceneNode.h" />
    <ClInclude Include="include\CadCore\ShaderProgram.h" />
    <ClInclude Include="include\CadCore\Shaders.h" />
    <ClInclude Include="include\CadCore\StlLoader.h" />
    <ClInclude Include="include\CadCore\Viewer.h" />
    <ClInclude Include="platform\WglContext.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\Renderer.cpp" />
    <ClCompile Include="src\Scene.cpp" />
    <ClCompile Include="src\SceneNodes.cpp" />
    <ClCompile Include="src\ShaderProgram.cpp" />
    <ClCompile Include="src\StlLoader.cpp" />
    <ClCompile Include="src\Viewer.cpp" />
    <ClCompile Include="platform\WglContext.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Not built by Visual Studio: cross-platform build file and GLFW test host. -->
    <None Include="CMakeLists.txt" />
    <None Include="examples\glfw_viewer.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
